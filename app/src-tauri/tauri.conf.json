{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeakGuard",
  "version": "0.1.9",
  "identifier": "com.caivy.neakguard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "NeakGuard", "width": 960, "height": 680, "resizable": false, "maximizable": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
